# PostgreSQL bootstrap account. Used only by the official image init scripts.
POSTGRES_DB=documents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-strong-password

# Least-privilege API account. Keep URI credentials URL-safe in this local example.
APP_DB_USER=documents_app
APP_DB_PASSWORD=replace-with-another-strong-password
DATABASE_URL=postgres://documents_app:replace-with-another-strong-password@db:5432/documents?sslmode=disable

# Separate least-privilege worker account.
WORKER_DB_USER=documents_worker
WORKER_DB_PASSWORD=replace-with-worker-db-password
WORKER_DATABASE_URL=postgres://documents_worker:replace-with-worker-db-password@db:5432/documents?sslmode=disable

# Argon2id pepper (>= 32 bytes); never commit .env.
PASSWORD_PEPPER=replace-with-random-secret-at-least-32-bytes

# Redis credentials and opaque-session policy.
REDIS_PASSWORD=replace-with-redis-password
REDIS_ADDR=redis:6379
SESSION_TTL_SECONDS=1800
API_ADDR=:8080

# RabbitMQ credentials for the worker publisher/consumer.
RABBITMQ_USER=documents_worker
RABBITMQ_PASSWORD=replace-with-rabbit-password
AMQP_URL=amqp://documents_worker:replace-with-rabbit-password@rabbitmq:5672/

# Local Mailpit SMTP sink; messages are visible in its web UI.
MAIL_SMTP_ADDR=mailpit:1025
MAIL_FROM=documents-system@localhost
