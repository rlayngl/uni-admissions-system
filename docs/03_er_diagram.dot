digraph ER { graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.45", ranksep="0.7", fontname="DejaVu Sans", labelloc="t", label="ER-диаграмма модели данных", fontsize=20]; node [fontname="DejaVu Sans", fontsize=8]; edge [fontname="DejaVu Sans", fontsize=7.5, color="#444444"];users [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id UUID</TD></TR><TR><TD ALIGN="LEFT">UQ university_id VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">UQ email VARCHAR(320)</TD></TR><TR><TD ALIGN="LEFT">service_unit_code VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">password_hash TEXT</TD></TR><TR><TD ALIGN="LEFT">password_pepper_version SMALLINT</TD></TR><TR><TD ALIGN="LEFT">is_active BOOLEAN</TD></TR></TABLE>>];roles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">PK role_id SMALLINT</TD></TR><TR><TD ALIGN="LEFT">UQ code VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">name VARCHAR(120)</TD></TR></TABLE>>];user_roles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>user_roles</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK user_id UUID</TD></TR><TR><TD ALIGN="LEFT">PK/FK role_id SMALLINT</TD></TR></TABLE>>];document_types [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>document_types</B></TD></TR><TR><TD ALIGN="LEFT">PK document_type_id SMALLINT</TD></TR><TR><TD ALIGN="LEFT">UQ code VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">name VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">active BOOLEAN</TD></TR></TABLE>>];applications [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>applications</B></TD></TR><TR><TD ALIGN="LEFT">PK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK owner_user_id UUID NOT NULL</TD></TR><TR><TD ALIGN="LEFT">service_unit_code VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">FK document_type_id SMALLINT</TD></TR><TR><TD ALIGN="LEFT">status VARCHAR(24)</TD></TR><TR><TD ALIGN="LEFT">comment TEXT</TD></TR><TR><TD ALIGN="LEFT">idempotency_key VARCHAR(128) UQ(owner,key)</TD></TR><TR><TD ALIGN="LEFT">idempotency_payload_hash VARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT">created_at TIMESTAMPTZ</TD></TR></TABLE>>];application_status_history [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>application_status_history</B></TD></TR><TR><TD ALIGN="LEFT">PK history_id BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK changed_by_user_id UUID</TD></TR><TR><TD ALIGN="LEFT">old_status</TD></TR><TR><TD ALIGN="LEFT">new_status</TD></TR><TR><TD ALIGN="LEFT">changed_at</TD></TR><TR><TD ALIGN="LEFT">request_id UUID</TD></TR></TABLE>>];documents [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>documents</B></TD></TR><TR><TD ALIGN="LEFT">PK document_id UUID</TD></TR><TR><TD ALIGN="LEFT">UQ/FK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK owner_user_id UUID NOT NULL</TD></TR><TR><TD ALIGN="LEFT">document_number UQ</TD></TR><TR><TD ALIGN="LEFT">document_content BYTEA</TD></TR><TR><TD ALIGN="LEFT">content_hash_sha256 CHAR(64)</TD></TR><TR><TD ALIGN="LEFT">FK issued_by_user_id UUID</TD></TR><TR><TD ALIGN="LEFT">issued_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];document_issue_events [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>document_issue_events</B></TD></TR><TR><TD ALIGN="LEFT">PK event_id BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK document_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK actor_user_id UUID</TD></TR><TR><TD ALIGN="LEFT">document_hash_sha256 CHAR(64)</TD></TR><TR><TD ALIGN="LEFT">request_id UUID</TD></TR></TABLE>>];audit_events [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>audit_events</B></TD></TR><TR><TD ALIGN="LEFT">PK audit_event_id BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK actor_user_id UUID</TD></TR><TR><TD ALIGN="LEFT">event_type</TD></TR><TR><TD ALIGN="LEFT">entity_type</TD></TR><TR><TD ALIGN="LEFT">entity_ref</TD></TR><TR><TD ALIGN="LEFT">event_time</TD></TR><TR><TD ALIGN="LEFT">details JSONB</TD></TR></TABLE>>];ai_checks [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>ai_checks</B></TD></TR><TR><TD ALIGN="LEFT">PK ai_check_id BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK owner_user_id UUID NOT NULL</TD></TR><TR><TD ALIGN="LEFT">FK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">model_name</TD></TR><TR><TD ALIGN="LEFT">input_fingerprint CHAR(64)</TD></TR><TR><TD ALIGN="LEFT">result JSONB</TD></TR></TABLE>>];notifications [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT">PK notification_id BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK application_id UUID</TD></TR><TR><TD ALIGN="LEFT">FK recipient_user_id UUID</TD></TR><TR><TD ALIGN="LEFT">notification_type</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">source_outbox_event_id UUID UQ/FK</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];outbox_events [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E6E6E6"><B>outbox_events</B></TD></TR><TR><TD ALIGN="LEFT">PK outbox_event_id UUID</TD></TR><TR><TD ALIGN="LEFT">aggregate_type</TD></TR><TR><TD ALIGN="LEFT">aggregate_id UUID</TD></TR><TR><TD ALIGN="LEFT">event_type</TD></TR><TR><TD ALIGN="LEFT">payload JSONB</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR></TABLE>>];users -> user_roles [label="1:N"];roles -> user_roles [label="1:N"];users -> applications [label="1:N owner"];document_types -> applications [label="1:N"];applications -> application_status_history [label="1:N"];users -> application_status_history [label="1:N actor"];applications -> documents [label="1:0..1"];users -> documents [label="1:N owner"];users -> documents [label="1:N issuer"];documents -> document_issue_events [label="1:N"];applications -> document_issue_events [label="1:N"];users -> document_issue_events [label="1:N actor"];users -> audit_events [label="1:N"];users -> ai_checks [label="1:N owner"];applications -> ai_checks [label="1:N"];applications -> notifications [label="1:N"];users -> notifications [label="1:N recipient"];}
